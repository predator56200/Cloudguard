{
  // TypeScript config. `strict: true` is the whole point — see the block below.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "incremental": true,
    "noEmit": true,

    // Non-negotiable (docs/11). From M5 the API types are GENERATED from the backend's OpenAPI schema. Strict mode is what turns that generated file into a real contract: a component cannot reference a field the API does not return, because tsc fails. Without strict (and with `any` allowed), the generated types become decorative and the frontend silently drifts from the backend — the single most common bug class in split-stack teams.
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "forceConsistentCasingInFileNames": true,

    "plugins": [{ "name": "next" }],

    // `@/` avoids ../../../ import chains, which break the moment you move a file.
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
