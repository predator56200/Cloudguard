"""${message}

Revision ID: ${up_revision}
Revises: ${down_revision | comma,n}
Created: ${create_date}

------------------------------------------------------------------------------
CHECKLIST — read before you merge this (docs/04 § Migrations)
------------------------------------------------------------------------------
[ ] Did you READ the autogenerated output? Autogenerate is a first draft, not an answer.

[ ] Is `downgrade()` real, and does it actually work?
    CI runs upgrade → downgrade → upgrade on every PR. A migration you cannot roll back is a
    deploy you cannot undo at 3am.

[ ] NEW TENANT TABLE? Then it needs ALL of this, and autogenerate writes NONE of it:
        op.execute("ALTER TABLE x ENABLE ROW LEVEL SECURITY")
        op.execute("ALTER TABLE x FORCE ROW LEVEL SECURITY")   # ← our app role OWNS the
                                                               #   tables, and owners BYPASS
                                                               #   RLS without FORCE. Omit
                                                               #   this and RLS silently does
                                                               #   nothing while every test
                                                               #   still passes.
        op.execute('''
            CREATE POLICY tenant_isolation ON x
              USING      (org_id = current_setting('app.current_org', true)::uuid)
              WITH CHECK (org_id = current_setting('app.current_org', true)::uuid)
        ''')                                                   # ← WITHOUT `WITH CHECK`, a
                                                               #   tenant can INSERT rows
                                                               #   belonging to ANOTHER
                                                               #   tenant. Read-isolated,
                                                               #   write-porous.

[ ] Destructive change (drop/rename a column)? Use EXPAND → MIGRATE → CONTRACT across
    several deploys. Never in one. Zero-downtime is not optional once customers exist.

[ ] Large table? `op.execute("SET lock_timeout = '3s'")` at the top, so a bad migration FAILS
    instead of silently holding an ACCESS EXCLUSIVE lock and taking the product down while it
    waits.
------------------------------------------------------------------------------
"""

from __future__ import annotations

from collections.abc import Sequence

import sqlalchemy as sa
from alembic import op
${imports if imports else ""}

revision: str = ${repr(up_revision)}
down_revision: str | None = ${repr(down_revision)}
branch_labels: str | Sequence[str] | None = ${repr(branch_labels)}
depends_on: str | Sequence[str] | None = ${repr(depends_on)}


def upgrade() -> None:
    ${upgrades if upgrades else "pass"}


def downgrade() -> None:
    ${downgrades if downgrades else "pass"}
