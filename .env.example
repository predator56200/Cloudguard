# =============================================================================
# CloudGuard AI — environment template
# =============================================================================
# Why this file exists:
#   - It is the DOCUMENTATION for every variable the system reads. `core/config.py` is the
#     enforcement; this is the contract.
#   - It contains NAMES and SAFE LOCAL DEFAULTS ONLY. Never a real secret. Ever.
#     (`.gitignore` blocks `.env`; `gitleaks` blocks it again in CI. Two layers, on purpose.)
#
# Usage:  cp .env.example .env
#
# Design note (docs/11-coding-standards.md § Configuration):
#   There are NO defaults for secrets in code. If a required variable is missing, the process
#   REFUSES TO BOOT. That turns a 3am production page into a failed deploy — which is exactly
#   where you want to find out.
# =============================================================================

# --- Runtime ---------------------------------------------------------------
# Drives log format (pretty vs JSON) and debug behaviour. Never used for `if ENV == "prod"`
# branching in business logic — that's what injected dependencies are for.
ENVIRONMENT=local          # local | test | staging | production
LOG_LEVEL=INFO             # DEBUG | INFO | WARNING | ERROR

# --- Database --------------------------------------------------------------
# asyncpg driver: the whole backend is async. A sync driver inside an async handler blocks
# the event loop and stalls EVERY concurrent request. See docs/11 § Python.
# Host is `postgres` (the compose service name) inside Docker, `localhost` from your shell.
DATABASE_URL=postgresql+asyncpg://cloudguard:cloudguard@postgres:5432/cloudguard
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=5
DATABASE_ECHO=false        # true = log every SQL statement. Local debugging only; very noisy.

# --- Redis -----------------------------------------------------------------
# Serves three roles: ARQ job queue, rate-limit token buckets, JWKS cache.
REDIS_URL=redis://redis:6379/0

# --- API -------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
# Comma-separated. The web app talks to the API through its own BFF proxy (docs/06), so in
# production this list is short. Never `*` with credentials — that combination is invalid
# per the CORS spec and browsers will reject it anyway.
CORS_ORIGINS=http://localhost:3000

# --- Frontend --------------------------------------------------------------
# Server-side only (no NEXT_PUBLIC_ prefix): the browser must NOT know the API origin.
# All browser traffic goes through /api/proxy. See docs/06-frontend.md § BFF proxy.
API_INTERNAL_URL=http://api:8000

# =============================================================================
# NOT USED IN M0 — listed so you know they're coming. Uncomment at the milestone shown.
# =============================================================================
# M1  CLERK_SECRET_KEY=
# M1  CLERK_PUBLISHABLE_KEY=
# M1  CLERK_JWKS_URL=
# M1  CLERK_WEBHOOK_SECRET=
# M2  AWS_REGION=us-east-1
# M2  CLOUDGUARD_SCANNER_ROLE_ARN=
# M2  KMS_KEY_ID=
# M6  ANTHROPIC_API_KEY=
# M7  RESEND_API_KEY=
# M7  S3_REPORTS_BUCKET=
# M8  STRIPE_SECRET_KEY=
# M8  STRIPE_WEBHOOK_SECRET=
# M8  SENTRY_DSN=
